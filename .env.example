# Google AI Studio Gemini API Configuration
GEMINI_API_KEY=your_primary_gemini_api_key
GEMINI_BACKUP_KEY=your_backup_gemini_api_key
GEMINI_MODEL=gemini-3.5-flash-lite

# Optional: Google Sheets Webhook URL for syncing leads & feedback
SHEETS_WEBHOOK_URL=

# Optional: External Analytics
NEXT_PUBLIC_POSTHOG_KEY=

# Optional: Upstash Redis for distributed rate limiting in production
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
